# Copy to .env and fill in your local database credentials. Never commit .env.
DB_USERNAME=dormitory_app
DB_PASSWORD=replace-with-your-local-application-password
DB_URL=jdbc:mysql://127.0.0.1:3306/susheguanli?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# Set a unique password (12+ characters, at most 72 UTF-8 bytes) before first boot.
ADMIN_INITIAL_PASSWORD=
# Optional. Keep the key on the backend only. Restart backend after editing.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-flash
COOKIE_SECURE=false
